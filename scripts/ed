#!/usr/bin/env bash
# ed: roda o editor.py com o Python isolado que tem o faster-whisper.
VENV=${CLAUDE_EDICAO_VENV:-$HOME/.local/share/claude-edicao/venv}
DIR=$(cd "$(dirname "$0")" && pwd)
if [ -x "$VENV/bin/python" ]; then exec "$VENV/bin/python" "$DIR/editor.py" "$@"; fi
exec python3 "$DIR/editor.py" "$@"
